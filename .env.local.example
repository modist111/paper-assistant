# ============================================================
# AI 论文阅读助手 — 环境变量配置
# ============================================================
# 本文件仅包含示例值，可以提交到 GitHub。不要在这里填写真实 API Key。
# 复制此文件为 .env.local 后，只在 .env.local 中填写真实密钥：
#   cp .env.local.example .env.local
# .env.local 已被 Git 忽略，不要强制添加或上传。
# 默认示例使用硅基流动 BAAI/bge-m3 (1024 维)，与 001_init.sql 一致。
# ============================================================

# ============================================================
# LLM 大语言模型 (问答生成)
# ============================================================
# 支持 OpenAI、DeepSeek 及任何兼容 /v1/chat/completions 的服务

# LLM API Key：只在 .env.local 中替换占位符，不能提交真实密钥。
LLM_API_KEY=sk-your-siliconflow-key

# LLM API Base URL
# OpenAI 默认:  https://api.openai.com/v1
# DeepSeek:      https://api.deepseek.com
# 硅基流动:       https://api.siliconflow.cn/v1
# Ollama 本地:    http://localhost:11434/v1
LLM_API_BASE_URL=https://api.siliconflow.cn/v1

# LLM 模型名
# OpenAI:        gpt-4o / gpt-4o-mini
# DeepSeek:      deepseek-chat (V3) / deepseek-reasoner (R1)
# 硅基流动:       Qwen/Qwen2.5-7B-Instruct
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ============================================================
# Embedding 文本向量化
# ============================================================

# Embedding API Key：可与 LLM_API_KEY 使用同一枚真实密钥。
EMBEDDING_API_KEY=sk-your-siliconflow-key

# Embedding API Base URL
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1

# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-m3

# 必须与数据库向量列及搜索函数维度一致。
EMBEDDING_DIMENSIONS=1024

# ============================================================
# OpenAI 可选配置（需分别配置 LLM 与 Embedding 的变量）
# ============================================================
# 若改用 OpenAI，请在 .env.local 把 LLM_API_BASE_URL 与 EMBEDDING_API_BASE_URL
# 都设置为 https://api.openai.com/v1，并把两个专用 API_KEY 设置为有效的 OpenAI 密钥。

# ============================================================
# OpenAI 可选配置（只在全新数据库初始化之前切换维度）
# ============================================================
# 如果使用 text-embedding-3-small，须将 001_init.sql 中的两处 VECTOR(1024)
# 改为 VECTOR(1536)，然后在 .env.local 中设置 OpenAI 的 API URL、模型和 1536 维。
# 已有向量不能只修改列维度，应先制定备份和重新索引方案。

# ============================================================
# Supabase (必需)
# ============================================================
# 从 Supabase Dashboard → Project Settings → API 获取

# Supabase 项目 URL (公开)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase 匿名密钥 (公开，受 RLS 限制)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Service Role 密钥 (机密，仅服务端使用)
# ⚠️ 此密钥绕过 RLS，永远不要暴露给客户端
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 数据库迁移专用（可选）：从 Supabase Connect -> Session pooler 复制 URI。
# 只在本机 .env.local 填写数据库密码。不是 service_role key。
# DATABASE_URL=postgresql://postgres.project-ref:YOUR-URL-ENCODED-PASSWORD@your-pooler-host:5432/postgres
# 默认使用仓库内 Supabase 官方公开 CA；其他数据库可显式指定 CA 文件。
# DATABASE_SSL_CA_FILE=/absolute/path/to/database-ca.crt
