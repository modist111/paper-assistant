# ============================================================
# AI 论文阅读助手 — 环境变量配置
# ============================================================
# 本文件仅包含示例值，可以提交到 GitHub。不要在这里填写真实 API Key。
# 复制此文件为 .env.local 后，只在 .env.local 中填写真实密钥：
#   cp .env.local.example .env.local
# .env.local 已被 Git 忽略，不要强制添加或上传。
# 默认示例使用 OpenAI (1536 维)，与 supabase/migrations/001_init.sql 一致。
# ============================================================

# ============================================================
# LLM 大语言模型 (问答生成)
# ============================================================
# 支持 OpenAI、DeepSeek 及任何兼容 /v1/chat/completions 的服务

# LLM API Key (如不设置，回退到 OPENAI_API_KEY)
# LLM_API_KEY=sk-your-llm-key

# LLM API Base URL
# OpenAI 默认:  https://api.openai.com/v1
# DeepSeek:      https://api.deepseek.com
# 硅基流动:       https://api.siliconflow.cn/v1
# Ollama 本地:    http://localhost:11434/v1
# LLM_API_BASE_URL=https://api.openai.com/v1

# LLM 模型名
# OpenAI:        gpt-4o / gpt-4o-mini
# DeepSeek:      deepseek-chat (V3) / deepseek-reasoner (R1)
# 硅基流动:       Qwen/Qwen2.5-7B-Instruct
LLM_MODEL=gpt-4o

# ============================================================
# Embedding 文本向量化
# ============================================================

# Embedding API Key (如不设置，回退到 OPENAI_API_KEY；请勿保留示例密钥)
# EMBEDDING_API_KEY=sk-your-embedding-key

# Embedding API Base URL (如不设置，回退到 OPENAI_API_BASE_URL)
# EMBEDDING_API_BASE_URL=https://api.openai.com/v1

# Embedding 模型 (默认 text-embedding-3-small, 1536d)
# EMBEDDING_MODEL=text-embedding-3-small

# 必须与数据库向量列及搜索函数维度一致：bge-m3 为 1024，text-embedding-3-small 为 1536。
# EMBEDDING_DIMENSIONS=1536

# ============================================================
# 通用 OpenAI Key (Embedding 和 LLM 共用的回退值)
# ============================================================
# 如果你 Embedding 和 LLM 都用 OpenAI，只需设置这一个
# 如果你 LLM 用 DeepSeek、Embedding 用 OpenAI，则单独设置上面的 LLM_API_KEY
OPENAI_API_KEY=sk-your-openai-key

# OpenAI API Base URL (Embedding 的默认回退值)
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# ============================================================
# 硅基流动示例（在 .env.local 中替换默认模型配置，不要在本文件填写密钥）
# ============================================================
# LLM 和 Embedding 可使用同一枚硅基流动密钥，但两个变量都要配置。
# 将下列示例行复制到 .env.local，去掉行首 #，并替换密钥占位符。
# 同一变量只保留一份配置；URL 直接写 https://，不要加反斜杠。
# LLM_API_KEY=替换为硅基流动密钥
# LLM_API_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# EMBEDDING_API_KEY=替换为硅基流动密钥
# EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSIONS=1024
# bge-m3 的向量是 1024 维。新数据库执行 001_init.sql 前，须把其中两处 VECTOR(1536)
# 改为 VECTOR(1024)；已有 1536 维向量不能直接用于 bge-m3，需重新索引。

# ============================================================
# Supabase (必需)
# ============================================================
# 从 Supabase Dashboard → Project Settings → API 获取

# Supabase 项目 URL (公开)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase 匿名密钥 (公开，受 RLS 限制)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Service Role 密钥 (机密，仅服务端使用)
# ⚠️ 此密钥绕过 RLS，永远不要暴露给客户端
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
